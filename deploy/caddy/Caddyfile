{
	admin off
}

{$SENTINELOPS_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
	}

	route {
		@actuator path /actuator /actuator/*
		respond @actuator 404

		@internal path /internal /internal/*
		respond @internal 404

		@demoCheckout path /api/checkout /api/checkout/*
		respond @demoCheckout 404

		@health path /healthz
		handle @health {
			rewrite * /actuator/health/readiness
			reverse_proxy ops-api:8080
		}

		handle {
			reverse_proxy web:8080
		}
	}
}
