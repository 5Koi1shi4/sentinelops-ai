{
  "uid": "sentinelops-overview",
  "title": "SentinelOps Overview",
  "description": "Incident flow, service recovery, and outbox health.",
  "tags": ["sentinelops", "operations"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "links": [
    {
      "title": "Explore traces in Tempo",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22%3A%22tempo%22%7D",
      "targetBlank": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Detected incidents by severity",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (severity) (rate(sentinelops_incident_detected_total[$__rate_interval]))", "legendFormat": "{{severity}}", "range": true }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Diagnosis completions by result",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (rate(sentinelops_diagnosis_completed_total[$__rate_interval]))", "legendFormat": "{{result}}", "range": true }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Mean time to detect (MTTD)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(sentinelops_incident_mttd_milliseconds_sum[$__rate_interval])) / sum(rate(sentinelops_incident_mttd_milliseconds_count[$__rate_interval])) / 1000", "legendFormat": "Average MTTD", "range": true }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Incident MTTR",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(sentinelops_incident_mttr_milliseconds_sum[$__rate_interval])) / sum(rate(sentinelops_incident_mttr_milliseconds_count[$__rate_interval])) / 1000", "legendFormat": "Average MTTR", "range": true }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Outbox backlog and publish failures",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(sentinelops_outbox_backlog)", "legendFormat": "Backlog", "range": true },
        { "refId": "B", "expr": "sum(rate(sentinelops_outbox_publish_failures_total[$__rate_interval]))", "legendFormat": "Publish failures/s", "range": true }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Executor stream lag",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "refId": "A", "expr": "max(sentinelops_executor_stream_lag)", "legendFormat": "Worst executor lag", "range": true }
      ]
    }
  ]
}
