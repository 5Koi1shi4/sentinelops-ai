{
  "uid": "sentinelops-execution",
  "title": "SentinelOps Execution",
  "description": "Approval flow, executor outcomes, recovery time, and outbox quarantine.",
  "tags": ["sentinelops", "execution"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "30s",
  "links": [
    {
      "title": "Explore traces in Tempo",
      "type": "link",
      "url": "/explore?left=%7B%22datasource%22%3A%22tempo%22%7D",
      "targetBlank": true,
      "keepTime": true
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Approval decisions by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(sentinelops_approval_decisions_total[$__rate_interval]))", "legendFormat": "{{status}}", "range": true }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Execution outcomes by status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (status) (rate(sentinelops_execution_outcomes_total[$__rate_interval]))", "legendFormat": "{{status}}", "range": true }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Average approval latency",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(sentinelops_approval_latency_milliseconds_sum[$__rate_interval])) / sum(rate(sentinelops_approval_latency_milliseconds_count[$__rate_interval])) / 1000", "legendFormat": "Average latency", "range": true }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Outbox quarantine backlog",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "refId": "A", "expr": "sum(sentinelops_outbox_quarantine_backlog)", "legendFormat": "Quarantined", "range": true }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Executor stream lag",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "refId": "A", "expr": "max(sentinelops_executor_stream_lag)", "legendFormat": "Worst executor lag", "range": true }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Execution lease conflicts",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(sentinelops_execution_lease_conflicts_total[$__rate_interval]))", "legendFormat": "Lease conflicts/s", "range": true }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Execution fencing conflicts",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "hidden", "placement": "bottom" }, "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(sentinelops_execution_fencing_conflicts_total[$__rate_interval]))", "legendFormat": "Fencing conflicts/s", "range": true }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Approval funnel",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(sentinelops_approval_requests_total[$__rate_interval]))", "legendFormat": "Requested/s", "range": true },
        { "refId": "B", "expr": "sum(rate(sentinelops_approval_decisions_total{status=\"approved\"}[$__rate_interval]))", "legendFormat": "Approved/s", "range": true },
        { "refId": "C", "expr": "sum(rate(sentinelops_approval_decisions_total{status=\"rejected\"}[$__rate_interval]))", "legendFormat": "Rejected/s", "range": true }
      ]
    }
  ]
}
