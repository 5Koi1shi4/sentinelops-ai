# Copy to an operator-managed environment file. Keep all secret values in files
# outside this repository and set restrictive ownership/permissions on those files.
SENTINELOPS_DOMAIN=sentinelops.example.com
SENTINELOPS_ALLOWED_ORIGINS=https://sentinelops.example.com
SENTINELOPS_OIDC_BROWSER_ORIGIN=https://identity.example.com
SENTINELOPS_OIDC_ISSUER=https://identity.example.com/realms/operations
SENTINELOPS_OIDC_JWK_SET_URI=https://identity.example.com/realms/operations/protocol/openid-connect/certs
SENTINELOPS_OIDC_TOKEN_URI=https://identity.example.com/realms/operations/protocol/openid-connect/token
SENTINELOPS_OIDC_BROWSER_CLIENT_ID=sentinelops-console
SENTINELOPS_OIDC_REDIRECT_URI=https://sentinelops.example.com/auth/callback

# Use the external managed endpoints by default. For local-data, set the JDBC URL
# to jdbc:postgresql://postgres:5432/sentinelops, the Valkey host to valkey,
# and SENTINELOPS_VALKEY_SSL_ENABLED to false; then use --profile local-data.
# The external PostgreSQL certificate must chain to the Java trust store.
SENTINELOPS_DB_URL=jdbc:postgresql://postgres.example.com:5432/sentinelops?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
SENTINELOPS_DB_USERNAME=sentinelops_app
SENTINELOPS_DB_MIGRATOR_USERNAME=sentinelops_migrator
# Local PostgreSQL uses the repository's fixed `sentinelops` administrator role.
SENTINELOPS_DB_ADMIN_PASSWORD_FILE=/etc/sentinelops/secrets/db-admin-password
SENTINELOPS_DB_APP_PASSWORD_FILE=/etc/sentinelops/secrets/db-app-password
SENTINELOPS_DB_MIGRATOR_PASSWORD_FILE=/etc/sentinelops/secrets/db-migrator-password
SENTINELOPS_VALKEY_HOST=valkey.example.com
SENTINELOPS_VALKEY_PORT=6379
SENTINELOPS_VALKEY_USERNAME=sentinelops
SENTINELOPS_VALKEY_SSL_ENABLED=true
SENTINELOPS_VALKEY_PASSWORD_FILE=/etc/sentinelops/secrets/valkey-password
SENTINELOPS_VALKEY_ACL_FILE=/etc/sentinelops/secrets/valkey-users.acl

# Provide the reviewed production target catalog and HTTPS health endpoint. The
# catalog is mounted read-only into ops-executor and may contain only allowlisted targets.
SENTINELOPS_TARGETS_HTTP_CATALOG_FILE=/etc/sentinelops/targets/http-actions.json
SENTINELOPS_PROD_CHECKOUT_HEALTH_URL=https://checkout.example.com/actuator/health/readiness
SENTINELOPS_EXECUTOR_ID=executor-prod-01
# Create this Docker network before deployment and apply a host firewall allowlist
# for the OIDC token URL, remote Valkey (if selected), and catalog target origins.
SENTINELOPS_EXECUTOR_EGRESS_NETWORK=sentinelops-executor-egress
SENTINELOPS_EXECUTOR_CLIENT_ID=sentinelops-executor

# Model provider settings use external services; the API key itself is file-injected.
SENTINELOPS_AI_PROVIDER=openai-compatible
SENTINELOPS_AI_BASE_URL=https://api.example-model.com/v1
SENTINELOPS_AI_MODEL=operator-approved-chat-model
SENTINELOPS_AI_EMBEDDING_MODEL=operator-approved-embedding-model
SENTINELOPS_AI_EMBEDDING_DIMENSIONS=1536
SENTINELOPS_PROMETHEUS_URL=https://prometheus.example.com
SENTINELOPS_LOKI_URL=https://loki.example.com

# Secret file paths: each file must be provisioned by the host secret manager.
SENTINELOPS_EXECUTOR_CLIENT_SECRET_FILE=/etc/sentinelops/secrets/executor-oauth-client-secret
SENTINELOPS_EXECUTION_SIGNING_KEY_FILE=/etc/sentinelops/secrets/execution-signing-private-jwk
SENTINELOPS_WEBHOOK_SECRET_FILE=/etc/sentinelops/secrets/alertmanager-webhook-secret
SENTINELOPS_MODEL_API_KEY_FILE=/etc/sentinelops/secrets/model-api-key

# Required only when using --profile local-data; create an ACL file containing
# an explicit Valkey user rule and a distinct local PostgreSQL admin password file.
# Create both directories before deployment and grant UID 10001 write access.
SENTINELOPS_CADDY_DATA_DIR=/var/lib/sentinelops/caddy/data
SENTINELOPS_CADDY_CONFIG_DIR=/var/lib/sentinelops/caddy/config
